# ============================================================
# Overlap Bot — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# Required
# ------------------------------------------------------------

# Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your-discord-bot-token-here

# PostgreSQL connection string. The schema comes from overlap/db/migrations
# (run `dbmate up`); the bot never creates tables and refuses to start if the
# database is behind. With docker-compose, this is set for you from
# POSTGRES_PASSWORD below — set it here yourself only if you bring your own
# database (delete the "db" service in docker-compose.yml first).
DATABASE_URL=postgresql://user:password@host:5432/overlap

# Password for the Postgres container docker-compose starts for you.
# Not used if you bring your own database.
POSTGRES_PASSWORD=change-me

# ------------------------------------------------------------
# Discord (Optional)
# ------------------------------------------------------------

# Restrict slash commands to one guild during development.
# Omit (or leave blank) for global commands (up to 1 hour propagation).
# DEV_GUILD_ID=123456789012345678

# ------------------------------------------------------------
# Database (Optional)
# ------------------------------------------------------------

# Connection pool size (defaults: 1 and 5)
# DB_POOL_MIN=1
# DB_POOL_MAX=5

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------

# Log level: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO

# ------------------------------------------------------------
# Feature Limits
# ------------------------------------------------------------

# Maximum active events per server (default: 10)
# MAX_ACTIVE_EVENTS=10

# ------------------------------------------------------------
# Web Server (health checks, vote redirect)
# ------------------------------------------------------------

# Public URL, used for vote-link click tracking. Set this to your public
# HTTPS URL in production — localhost will not work for that.
# WEB_BASE_URL=https://your-domain.com

# Internal bind address and port (default: 0.0.0.0:8080)
# WEB_HOST=0.0.0.0
# WEB_PORT=8080

# ------------------------------------------------------------
# Runtime
# ------------------------------------------------------------

# Set to "production" to enable stricter validation
# ENV=production
